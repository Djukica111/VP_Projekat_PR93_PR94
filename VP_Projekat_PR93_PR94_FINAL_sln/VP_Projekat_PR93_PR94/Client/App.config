<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<system.serviceModel>
		<client>
			<endpoint
			  name="EVChargingEndpoint"
			  address="net.tcp://localhost:8000/EVCharging"
			  binding="netTcpBinding"
			  bindingConfiguration="largeTcpBinding"
			  contract="Common.IEVChargingService" />
		</client>
		<bindings>
			<netTcpBinding>
				<binding name="largeTcpBinding"
						 maxReceivedMessageSize="10485760"
						 transferMode="Streamed"
						 receiveTimeout="00:10:00"
						 sendTimeout="00:10:00">
					<security mode="None"/>
				</binding>
			</netTcpBinding>
		</bindings>
	</system.serviceModel>
</configuration>