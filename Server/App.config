<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<system.serviceModel>
		<services>
			<service name="Server.EVChargingService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:8000" />
					</baseAddresses>
				</host>
				<endpoint
				  address="EVCharging"
				  binding="netTcpBinding"
				  bindingConfiguration="largeTcpBinding"
				  contract="Common.IEVChargingService" />
			</service>
		</services>
		<bindings>
			<netTcpBinding>
				<binding name="largeTcpBinding"
						 maxReceivedMessageSize="10485760"
						 transferMode="Streamed"
						 receiveTimeout="00:10:00"
						 sendTimeout="00:10:00">
					<security mode="None"/>
				</binding>
			</netTcpBinding>
		</bindings>
	</system.serviceModel>
	<appSettings>
		<add key="OverloadWarningThreshold" value="50000"/>
		<add key="FrequencySpikeThreshold" value="1.0"/>
	</appSettings>
</configuration>